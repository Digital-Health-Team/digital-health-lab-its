APP_NAME="Laravel 12 Hybrid Action Oriented"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mbkm_logbook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fallback WhatsApp number (international format, no +) for order price negotiation
ADMIN_WHATSAPP_NUMBER=

# Payment info (shown to users on training payment step)
PAYMENT_QRIS_IMAGE_URL=
PAYMENT_BANK_NAME=BNI
PAYMENT_BANK_ACCOUNT_NAME="Lab Digital Health ITS"
PAYMENT_BANK_ACCOUNT_NUMBER=

# CHATBOT (RAG) — see docs/rag-chatbot/SETUP-GEMINI.md and OPERASIONAL.md
GEMINI_API_KEY=""
GEMINI_BASE_URL=

# Verify against your own key before filling these in; a model that answers for one
# account can return 404 for another. Do not use `-latest` aliases.
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=

# Changing this after the first ingest requires `php artisan chatbot:index --fresh`.
GEMINI_EMBEDDING_DIMENSIONS=

# thinkingLevel (Gemini 3 series), a string: low | medium | high. Never thinkingBudget.
GEMINI_THINKING_LEVEL=
GEMINI_HISTORY_TURNS=

RAG_TOP_K=
RAG_MIN_SCORE=
RAG_CACHE_TTL=
# Pause between embedding calls during ingest, in milliseconds. Raise it if the first
# full index run hits 429 part-way through.
RAG_EMBED_DELAY_MS=

# Requests per minute for POST /chatbot/ask. These protect the Gemini daily quota, not the
# web server. Both default to 20: the chatbot is public, and the guest key is an IP shared
# by everyone behind one campus NAT. Lower them if your project's RPD is only a few hundred.
CHATBOT_THROTTLE_USER=
CHATBOT_THROTTLE_GUEST=
